# bcrypt hash of the admin password (cost 12)
ADMIN_PASSWORD_HASH=

# 32+ byte random secret for signing session tokens
SESSION_SECRET=

# Fine-grained GitHub personal access token with contents read/write on this repo
GITHUB_TOKEN=

# GitHub owner / username that owns the repo
GITHUB_OWNER=

# GitHub repository name
GITHUB_REPO=

# GitHub branch to commit posts to (defaults to "main" if unset)
GITHUB_BRANCH=
